<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Версия Windows в TFM открывает проекции WinRT: управление медиа
         (GlobalSystemMediaTransportControls) и сведения о батарее — штатным
         API вместо самописных обходных путей. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>

    <!-- Единственное место, где живёт номер версии. Отсюда его берут окно
         «О программе», свойства exe и установщик. Порядок выпуска описан
         в CHANGELOG.md. -->
    <Version>1.0.2</Version>

    <!-- Иначе .NET дописывает в ProductVersion хеш коммита («1.0.1+1b1d52…»),
         а установщик берёт номер версии именно оттуда. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Company>FSDITM</Company>
    <Product>DynamicIsland</Product>
    <Description>Динамический островок для Windows</Description>
    <Copyright>© 2026 FSDITM</Copyright>

    <!-- WPF нужен только окну настроек. Оверлей рисуется своим GPU-ядром,
         и эти сборки грузятся лишь при первом открытии настроек. -->
    <UseWPF>true</UseWPF>

    <!-- Оверлей живёт в фоне часами: воркстейшн-GC без фонового потока даёт
         меньше пауз и меньше простаивающих потоков, чем серверный GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Переводы служебных сообщений .NET на 13 языков тянут в сборку 8 МБ.
         Интерфейс у приложения свой, эти ресурсы не используются. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rubik: вариативный шрифт для времени, даты и заряда.
         SIL Open Font License, текст лицензии лежит рядом. -->
    <None Include="Resources\Fonts\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- Иконка нужна и рядом с exe: трей и окно настроек грузят её файлом. -->
    <None Include="Resources\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.Direct3D.Vortice" Version="4.151.1" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <!-- Пакет SkiaSharp кладёт рядом с нативной библиотекой её отладочные
       символы: 85 МБ на 12 МБ кода. Пользователю они не нужны, а установщик
       из-за них растёт вдвое. Удаляем после публикации, а не вручную перед
       сборкой установщика, — иначе однажды забудешь. -->
  <Target Name="RemoveSkiaNativeSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>

</Project>
