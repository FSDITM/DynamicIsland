<Window x:Class="DynamicIsland.Configuration.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicIsland — настройки"
        Width="760" Height="620" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF16161A"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#FFF0F0F3"/>
        <SolidColorBrush x:Key="FgMuted" Color="#FF9A9AA4"/>
        <SolidColorBrush x:Key="Panel" Color="#FF1E1E24"/>
        <SolidColorBrush x:Key="Accent" Color="#FF48BEFF"/>
        <SolidColorBrush x:Key="Line" Color="#FF2C2C34"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF26262E"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="16,9" Margin="0,0,4,0"
                                CornerRadius="8">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF23232B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="#FF26262E"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33333D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Background="{StaticResource Panel}" BorderThickness="0"
                    Padding="18" Margin="0,10,0,0">

            <!-- ================= Внешний вид ================= -->
            <TabItem Header="Внешний вид">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppearancePanel" Margin="4,0,14,0"/>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Поведение ================= -->
            <TabItem Header="Поведение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BehaviourPanel" Margin="4,0,14,0"/>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Расположение ================= -->
            <TabItem Header="Расположение">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlacementPanel" Margin="4,0,14,0"/>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Содержимое ================= -->
            <TabItem Header="Содержимое">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel" Margin="4,0,14,0"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="Изменения применяются сразу и сохраняются автоматически."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Открыть файл настроек" Style="{StaticResource Action}" Click="OnOpenFile"/>
                <Button Content="Сбросить всё" Style="{StaticResource Action}" Click="OnReset"/>
                <Button Content="Закрыть" Style="{StaticResource Action}" Click="OnClose"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
